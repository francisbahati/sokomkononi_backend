# ============================================================
# SokoMkononi — production environment template
# ============================================================

SECRET_KEY=change-me-to-a-64-character-random-string-replace-me-please!!
DEBUG=False
ALLOWED_HOSTS=sokomkononi.co.tz,www.sokomkononi.co.tz,api.sokomkononi.co.tz
CORS_ALLOWED_ORIGINS=https://sokomkononi.co.tz,https://www.sokomkononi.co.tz
CSRF_TRUSTED_ORIGINS=https://sokomkononi.co.tz,https://www.sokomkononi.co.tz
CORS_ALLOW_CREDENTIALS=True

# ---------------- DATABASE ----------------
DB_NAME=sokomkononi
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# ---------------- CELERY ----------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---------------- EMAIL ----------------
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=no-reply@sokomkononi.co.tz
EMAIL_HOST_PASSWORD=change-me
DEFAULT_FROM_EMAIL=SokoMkononi <no-reply@sokomkononi.co.tz>
ADMIN_EMAIL=info@sokomkononi.co.tz

# ---------------- R2 STORAGE ----------------
R2_BUCKET_NAME=sokomkononi-media
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=change-me
R2_SECRET_ACCESS_KEY=change-me
R2_CUSTOM_DOMAIN=media.sokomkononi.co.tz
R2_MEDIA_LOCATION=media

# ---------------- SOCIAL LOGIN ----------------
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ---------------- SMS ----------------
PYNEXTSMS_TOKEN=
PYNEXTSMS_SENDER_ID=

# ---------------- FIMIPAY ----------------
FIMIPAY_SECRET_KEY=sk_live_change_me
FIMIPAY_WEBHOOK_SECRET=change-me-webhook-secret
FIMIPAY_CURRENCY=TZS

# ---------------- OPTIONAL ----------------
RESTRICT_DOCS=True
SENTRY_DSN=
SENTRY_TRACES_RATE=0.1
SENTRY_ENV=production

# First-run seeder gate. Set to 1 to seed categories + fee rules once.
SOKO_RUN_SEEDERS=0
SOKO_SKIP_INIT=0

# Seed a superuser on boot (leave blank to skip)
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_NAME=Admin
DJANGO_SUPERUSER_PASSWORD=
