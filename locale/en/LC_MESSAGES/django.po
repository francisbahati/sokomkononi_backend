msgid ""
"Ombi limekataliwa na admin. Tafadhali wasiliana na support "
"kwa maelezo zaidi."
msgstr ""
"The request has been rejected by an admin. Please contact support "
"for more details."

msgid "Tafadhali pakia nyaraka za ziada ili kukamilisha uthibitisho."
msgstr "Please upload additional documents to complete verification."

