msgid "Idhinisha maombi yaliyochaguliwa"
msgstr "Approve selected requests"

msgid "Kataa maombi yaliyochaguliwa"
msgstr "Reject selected requests"

msgid "Omba nyaraka zaidi (kwa uteuzi)"
msgstr "Request more documents (for selection)"

msgid "Hakuna maombi ya PENDING kwenye uteuzi."
msgstr "No PENDING requests in the selection."

msgid "Maombi %(n)s yameidhinishwa."
msgstr "%(n)s request(s) approved."

