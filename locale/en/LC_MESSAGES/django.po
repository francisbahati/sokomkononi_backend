msgid "Uthibitisho wako umeidhinishwa"
msgstr "Your verification has been approved"

msgid ""
"Ombi lako la kuthibitishwa kuwa {type} limeidhinishwa. Sasa unaweza "
"kufanya biashara kwa uhuru."
msgstr ""
"Your request to be verified as {type} has been approved. You can now "
"trade freely."

msgid "Uthibitisho umekataliwa"
msgstr "Verification rejected"

msgid ""
"Ombi lako la kuthibitishwa kuwa {type} limekataliwa. Sababu: {reason}"
msgstr ""
"Your request to be verified as {type} has been rejected. Reason: {reason}"

msgid "Nyaraka zaidi zinahitajika"
msgstr "More documents required"

msgid "Tafadhali pakia nyaraka zaidi."
msgstr "Please upload more documents."

