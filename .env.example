# ─── Django core ─────────────────────────────────────
SECRET_KEY=change-me-to-50-plus-random-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.sokomkononi.co.tz
ADMIN_PATH=/smk-control-9x7k

# ─── Database ────────────────────────────────────────
DB_NAME=sokomkononi
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# ─── Redis / Celery ──────────────────────────────────
REDIS_PASSWORD=change-me
CELERY_BROKER_URL=redis://:change-me@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-me@redis:6379/0

# ─── Auth ────────────────────────────────────────────
# REQUIRED in production — without these, social login is disabled.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# ─── SMS (OTP) ───────────────────────────────────────
PYNEXTSMS_TOKEN=
PYNEXTSMS_SENDER_ID=

# ─── Email ───────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=SokoMkononi <no-reply@sokomkononi.co.tz>
ADMIN_EMAIL=sokomkononi@sokomkononi.co.tz

# ─── FimiPay (REQUIRED in prod) ──────────────────────
FIMIPAY_SECRET_KEY=
FIMIPAY_WEBHOOK_SECRET=
FIMIPAY_CURRENCY=TZS
FIMIPAY_BASE_URL=https://fimipay.com/api/v1

# ─── Cloudflare R2 ───────────────────────────────────
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_CUSTOM_DOMAIN=
R2_MEDIA_LOCATION=media
R2_PRIVATE_LOCATION=private
SIGNED_URL_EXPIRY=3600

# ─── Turnstile ───────────────────────────────────────
TURNSTILE_SECRET_KEY=

# ─── CORS / CSRF ─────────────────────────────────────
CORS_ALLOWED_ORIGINS=https://sokomkononi.co.tz,https://www.sokomkononi.co.tz
CSRF_TRUSTED_ORIGINS=https://sokomkononi.co.tz,https://www.sokomkononi.co.tz

# ─── Superuser (created on first boot) ───────────────
DJANGO_SUPERUSER_EMAIL=admin@sokomkononi.co.tz
DJANGO_SUPERUSER_PASSWORD=change-me-now
DJANGO_SUPERUSER_NAME=Admin

# ─── Sentry (optional) ───────────────────────────────
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_TRACES_RATE=0.1

# ─── Fee behaviour ───────────────────────────────────
LISTING_FEE_ALLOW_FALLBACK=True
LISTING_FEE_REPRICE_AFTER_HOURS=24

# ─── QA-only (IGNORED in prod) ───────────────────────
SOKO_FIMIPAY_TEST_OUTCOME=
